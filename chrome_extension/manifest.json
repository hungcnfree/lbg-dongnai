{
  "manifest_version": 3,
  "name": "Trợ Lý CSDL Giáo Dục Toàn Tỉnh Đồng Nai",
  "version": "5.2.0",
  "description": "Tự động điền 100% Cấp học, Xã/Phường, Trường và Đăng nhập CSDL Đồng Nai qua Telerik Client Engine",
  "author": "Thầy Nông Văn Hùng & Cộng đồng AI Giáo dục Đồng Nai",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://truong.dongnai.edu.vn/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trợ Lý CSDL Đồng Nai v5.2"
  },
  "content_scripts": [
    {
      "matches": [
        "*://truong.dongnai.edu.vn/*"
      ],
      "js": [
        "page_bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://truong.dongnai.edu.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page_bridge.js"
      ],
      "matches": [
        "*://truong.dongnai.edu.vn/*"
      ]
    }
  ]
}
