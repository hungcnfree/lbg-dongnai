{
  "manifest_version": 3,
  "name": "Trợ Lý CSDL - THCS Đăk Ơ",
  "version": "5.4.1",
  "description": "Tiện ích tự động điền đăng nhập và hoàn thành lịch báo giảng 1-click (Đa định dạng TKB Siêu Thông Minh) dành riêng cho giáo viên trường THCS Đăk Ơ",
  "author": "Thầy Nông Văn Hùng & Cộng đồng AI Giáo dục Đồng Nai",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://truong.dongnai.edu.vn/*",
    "https://raw.githubusercontent.com/*",
    "https://hungcnfree.github.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trợ Lý CSDL THCS Đăk Ơ v5.4.1",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://truong.dongnai.edu.vn/*"
      ],
      "js": [
        "xlsx.mini.min.js",
        "template_lbg_base64.js",
        "default_school_tkb.js",
        "lbg_excel_engine.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page_bridge.js",
        "default_school_tkb.js",
        "xlsx.mini.min.js",
        "template_lbg_base64.js",
        "lbg_excel_engine.js",
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "*://truong.dongnai.edu.vn/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}