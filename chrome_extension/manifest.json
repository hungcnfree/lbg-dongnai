{
  "manifest_version": 3,
  "name": "Trợ Lý CSDL Giáo Dục Toàn Tỉnh Đồng Nai",
  "version": "5.3.1",
  "description": "Tự động điền 100% Cấp học, Xã/Phường, Trường và Đăng nhập CSDL Đồng Nai qua Telerik Client Engine",
  "author": "Thầy Nông Văn Hùng & Cộng đồng AI Giáo dục Đồng Nai",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://truong.dongnai.edu.vn/*",
    "https://raw.githubusercontent.com/*",
    "https://hungcnfree.github.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trợ Lý CSDL Toàn Tỉnh v5.3.1",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://truong.dongnai.edu.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page_bridge.js",
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "*://truong.dongnai.edu.vn/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}