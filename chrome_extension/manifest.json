{
  "manifest_version": 3,
  "name": "Trợ Lý CSDL Giáo Dục Toàn Tỉnh Đồng Nai",
  "version": "5.3.4",
  "description": "Tự động điền Cấp học, Xã/Phường, Trường, Đăng nhập CSDL và nạp Lịch báo giảng từ file Excel Thời khóa biểu",
  "author": "Thầy Nông Văn Hùng & Cộng đồng AI Giáo dục Đồng Nai",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://truong.dongnai.edu.vn/*",
    "https://raw.githubusercontent.com/*",
    "https://hungcnfree.github.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trợ Lý CSDL Toàn Tỉnh v5.3.4",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://truong.dongnai.edu.vn/*"
      ],
      "js": [
        "xlsx.mini.min.js",
        "template_lbg_base64.js",
        "lbg_excel_engine.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page_bridge.js",
        "xlsx.mini.min.js",
        "template_lbg_base64.js",
        "lbg_excel_engine.js",
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "*://truong.dongnai.edu.vn/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}